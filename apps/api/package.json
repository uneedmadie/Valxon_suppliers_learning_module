{
  "name": "@valxon/api",
  "version": "0.1.0",
  "private": true,
  "description": "VALXON Academy REST API (NestJS + TypeORM + SQLite).",
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config test/jest-e2e.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/typeorm": "^11.0.3",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "docx": "^9.11.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "pdfkit": "^0.20.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
