# VALXON Academy API – vzorová konfigurace. Zkopírujte na `.env` (ten se necommituje).
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Adresář pro SQLite DB, nahrané podklady a lokální tajemství (mimo Git).
DATA_DIR=./storage
# Tajemství pro podpis tokenů; prázdné = vygeneruje se lokálně do DATA_DIR/.auth-secret
AUTH_SECRET=
# Vývojové přihlášení bez hesla (jen lokální demo, NE produkční ochrana).
DEV_LOGIN_ENABLED=true
# Limity importu
IMPORT_MAX_PAGES=14
IMPORT_REQUEST_DELAY_MS=400
IMPORT_TIMEOUT_MS=15000
UPLOAD_MAX_MB=25
# Povolit import z localhost/privátních sítí – POUZE pro automatické testy.
IMPORT_ALLOW_PRIVATE_HOSTS=false
# Externí AI: bez schválení VALXON nechte prázdné. Adaptér zatím není implementován.
AI_PROVIDER=
AI_PROVIDER_APPROVED=false
